# Pie Relay 환경 변수 — /etc/pie-relay/relay.env 로 복사 후 값 채우고 chmod 600.
#   sudo install -Dm600 relay.env.example /etc/pie-relay/relay.env
#   sudo nano /etc/pie-relay/relay.env

# JWT 서명·검증 공유 시크릿 (필수). 두 레그(/ws/agent, /ws/participant)가 같은 값을 씀.
# 이 값을 바꾸면 기존에 발급된 모든 토큰이 무효가 되어 호스트/참가자가 재발급(방 만들기/재참가)
# 해야 하므로, 한 번 정하면 재시작 때 바꾸지 말 것. 강한 랜덤값 사용:
#   openssl rand -base64 48
RELAY_JWT_SECRET=change-me-to-a-long-random-secret

# 서비스별 Relay Pool 격리. 모든 소비자가 v3 context token으로 전환되기 전에는
# REQUIRE를 false로 두고, 전환이 끝난 뒤 true로 올린다.
RELAY_NODE_ID=relay-1
RELAY_POOL_ID=pie-relay-default
RELAY_ALLOWED_APPLICATIONS=pie-relay-desktop,pie-mobile
RELAY_REQUIRE_POOL_SCOPE=false

# 비-loopback 에서 호스트가 /host/enroll 로 방을 만들 때 필요한 발급 키.
# 미설정 시 /host/enroll 은 503(원격 enroll 비활성). 호스트 앱의 "발급 키" 필드에
# 동일한 값을 입력해야 함.
HOST_ENROLL_SECRET=change-me-enroll-secret

# (선택) 발급 토큰 TTL 등 추가 옵션이 있으면 여기에.
#HOST_ENROLL_TTL=24h

# 로컬 개발 전용. true이면 직접 loopback 요청이 발급 키 없이 /host/enroll 가능.
# 같은 머신의 nginx/Caddy 등 리버스 프록시 뒤에서는 외부 요청도 loopback으로 보이므로
# 절대 활성화하지 말 것. 공개 배포 기본값은 false.
ALLOW_LOOPBACK_ENROLL_WITHOUT_SECRET=false

# 구버전 URL 토큰 호환. URL/access log에 JWT가 남으므로 운영 기본값은 false.
RELAY_ALLOW_LEGACY_QUERY_TICKET=false
# iss/aud/jti/role/cap 없는 구형 JWT 호환. 운영 기본값은 반드시 false.
RELAY_ALLOW_LEGACY_UNSCOPED_TOKENS=false

# 모바일 재연결 credential은 원문이 아니라 해시 상태로 이 파일에 저장된다.
RELAY_MOBILE_STATE_FILE=/var/lib/pie-relay/mobile-state.json
# Required only for storage backends such as Azure Files (SMB) that do not
# implement POSIX chmod. Keep false/unset on normal POSIX filesystems.
RELAY_MOBILE_STATE_ALLOW_UNSUPPORTED_MODE=false
