PIE_MANAGER_URL=http://127.0.0.1:19090
PIE_INTEGRATION_ID=sample-web-chat
PIE_INTEGRATION_TOKEN=pie_int_replace_with_the_one_time_service_token
PIE_WEB_CHAT_USERS_FILE=./var/users.json
PIE_WEB_CHAT_HOST=127.0.0.1
PIE_WEB_CHAT_PORT=4175
PIE_WEB_CHAT_SECURE_COOKIE=false
# 운영 reverse proxy 뒤에서는 브라우저에 노출되는 정확한 HTTPS origin을 설정한다.
# PIE_WEB_CHAT_PUBLIC_ORIGIN=https://chat.example.com
