# `openssl rand -base64 48` 등으로 각각 다른 값을 생성하세요.
POSTGRES_PASSWORD=replace-with-a-long-random-password
RELAY_JWT_SECRET=replace-with-at-least-32-random-bytes
PIE_RELAY_ROUTING_SECRET=replace-with-a-different-32-byte-routing-secret
HOST_ENROLL_SECRET=replace-with-a-long-random-enrollment-secret
PIE_MANAGER_ADMIN_TOKEN=replace-with-a-long-random-admin-token
PIE_RELAY_CONTROL_TOKEN=replace-with-a-different-long-random-control-token
PIE_RELAY_PRESENCE_TOKEN=replace-with-a-third-long-random-presence-token
PIE_RELAY_METRICS_TOKEN=replace-with-a-fourth-long-random-metrics-token
PIE_DEVICE_AUTH_SECRET=replace-with-a-device-jwt-secret-of-at-least-32-bytes
PIE_PREVIEW_GATEWAY_TOKEN=replace-with-a-preview-gateway-token-of-at-least-32-bytes
PIE_PREVIEW_ACCESS_SECRET=replace-with-a-different-preview-access-secret-of-at-least-32-bytes

# Customer PAT verification. Set these to the external membership service.
PIE_AUTH_INTROSPECTION_URL=https://api.cookai.dev/oauth/introspect
PIE_AUTH_CLIENT_ID=pie-relay
PIE_AUTH_CLIENT_SECRET=replace-with-an-introspection-client-secret
PIE_AUTH_HTTP_TIMEOUT=5s
# 활성 PAT 폐기는 이 캐시 TTL 안에 반영됩니다.
PIE_AUTH_CACHE_TTL=30s
PIE_AUTH_NEGATIVE_CACHE_TTL=5s
PIE_CORS_ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost,http://localhost:1420,http://127.0.0.1:1420,https://admin-relay.cookai.dev
RELAY_ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost,https://cookai.dev,https://*.cookai.dev
RELAY_ALLOW_LEGACY_QUERY_TICKET=false
RELAY_ALLOW_LEGACY_UNSCOPED_TOKENS=false
RELAY_REQUIRE_POOL_SCOPE=true
# Pie Control 발급 토큰은 항상 pool scope를 요구한다. Relay 자체가 발급하는
# 모바일·수동 연결·초대 토큰만 별도 호환 경계로 허용한다.
RELAY_ALLOW_DIRECT_TOKENS_WITHOUT_POOL_SCOPE=true
PIE_USER_WEBHOOK_SECRET=replace-with-a-32-byte-or-longer-webhook-secret
PIE_DEFAULT_MAX_SESSIONS=8
PIE_DEFAULT_MAX_PARTICIPANTS=32
PIE_CONTROL_OPERATION_RETENTION=168h
PIE_CONTROL_RECONCILE_CONCURRENCY=8
PIE_CHAT_JOURNAL_MAX_BYTES=67108864
PIE_CHAT_EVENT_MAX_BYTES=8388608
PIE_CHAT_IDLE_SCAN_INTERVAL=1m
PIE_CHAT_SESSION_IDLE_TIMEOUT=15m
PIE_EXECUTOR_IDLE_TIMEOUT=1h
PIE_PREVIEW_DOMAIN=preview.kroot.io
PIE_PREVIEW_PUBLIC_SCHEME=https
PIE_PREVIEW_PUBLIC_PORT=0
PIE_PREVIEW_GATEWAY_CONTAINER=pie-preview-gateway
PIE_PREVIEW_DEFAULT_TTL=4h
PIE_PREVIEW_MAX_TTL=24h
PIE_PREVIEW_SESSION_TTL=8h

RELAY_PUBLIC_URL=https://relay.cookai.dev
RELAY_NODE_ID=relay-1
RELAY_POOL_ID=pie-relay-default
RELAY_ALLOWED_APPLICATIONS=pie-control,pie-relay-desktop,pie-mobile
PIE_RELAY_DEFAULT_APPLICATION_ID=pie-control
PIE_RELAY_HEARTBEAT_TIMEOUT=90s
PIE_EXECUTOR_MANAGER_ID=manager-1
PIE_EXECUTOR_IMAGE=pie-relay-client:latest
PIE_EXECUTOR_KROOT_AUTO_LINK=false
PIE_EXECUTOR_ALLOW_USER_NAMESPACES=false
PIE_DATA_DIR=/var/lib/pie-relay
PIE_CLAUDE_AUTH_REQUIRED=true
PIE_CLAUDE_AUTH_ROLLOUT_CONCURRENCY=4
PIE_CLAUDE_SUBSCRIPTION_MAX_CONCURRENT_TURNS=4
