# 공개 주소와 서버 안의 Pie 전용 데이터 경계
RELAY_PUBLIC_URL=https://relay-test.cookai.dev
PIE_TEST_DATA_DIR=/home/kaonkroot/pie-sandbox-test/data
# 사용자 프로젝트·Claude HOME·첨부파일처럼 큰 Executor 데이터는 별도 NVMe에 둔다.
PIE_EXECUTOR_VOLUME_DIR=/backup/pie-sandbox-test/executor-data

# 배포마다 고정할 이미지 태그. 실제 배포에서는 Git SHA/빌드 ID를 사용한다.
PIE_RELAY_IMAGE=pie-relay-server:test
PIE_MANAGER_IMAGE=pie-executor-manager:test
PIE_PREVIEW_GATEWAY_IMAGE=pie-preview-gateway:test
PIE_EXECUTOR_IMAGE=pie-relay-client-kroot:test
PIE_KROOT_COMMON_BUNDLE_VERSION=replace-with-kroot-adk-git-revision
PIE_CLAUDE_AUTH_REQUIRED=true
PIE_CLAUDE_AUTH_ROLLOUT_CONCURRENCY=2
PIE_CLAUDE_SUBSCRIPTION_MAX_CONCURRENT_TURNS=4
PIE_EXECUTOR_RELAY_URL=wss://relay-test.cookai.dev/ws/agent
PIE_EXECUTOR_MANAGER_ID=kroot-studio-manager-1
PIE_EXECUTOR_NETWORK=pie-sandbox-test-executor
PIE_EXECUTOR_KROOT_AUTO_LINK=true
PIE_EXECUTOR_ALLOW_USER_NAMESPACES=true

# 같은 공유 Traefik에서 여러 제품 프로필을 실행할 때 라우터 이름과 공개 Host가
# 겹치지 않아야 한다. 이 파일의 기본값은 Kroot Studio 검증 스택이다.
PIE_TRAEFIK_ROUTE_PREFIX=pie-sandbox-test
PIE_TRAEFIK_ROUTE_PRIORITY=100
PIE_RELAY_HOST=relay-test.cookai.dev
PIE_MANAGER_API_HOST=api-relay-test.cookai.dev
PIE_MANAGER_ADMIN_HOST=admin-relay-test.cookai.dev
PIE_WEB_CHAT_MANAGER_URL=https://api-relay-test.cookai.dev
PIE_WEB_CHAT_PUBLIC_HOST=chat-relay.cookai.dev

# 운영형 웹채팅은 profile을 명시했을 때만 실행한다. Integration token, DB 접속 URL,
# credential 암호화 키와 초기 사용자 파일은 image/env에 넣지 않고 서버의 mode 0600
# 파일을 read-only mount한다.
PIE_WEB_CHAT_IMAGE=pie-third-party-web-chat:test
PIE_WEB_CHAT_INTEGRATION_ID=cookai-e2e
# 현재 구성은 사용자마다 상시 실행 Executor 하나를 할당하므로 이 값은
# PIE_EXECUTOR_MAX_EXECUTORS 이상이어야 한다.
PIE_WEB_CHAT_MAX_USERS=15
PIE_WEB_CHAT_MAX_PROJECTS_PER_USER=4
PIE_WEB_CHAT_MAX_PREVIEWS_PER_USER=4
PIE_WEB_CHAT_MAX_CONVERSATIONS_PER_USER=2
PIE_WEB_CHAT_USERS_FILE=/home/kaonkroot/pie-sandbox-test/web-chat/users.json
PIE_WEB_CHAT_INTEGRATION_TOKEN_FILE=/home/kaonkroot/pie-sandbox-test/integration-e2e.token
PIE_WEB_CHAT_DATABASE_URL_FILE=/home/kaonkroot/pie-sandbox-test/web-chat/database-url
PIE_WEB_CHAT_CREDENTIAL_KEY_FILE=/home/kaonkroot/pie-sandbox-test/web-chat/credential-key
PIE_WEB_CHAT_REGISTRATION_ENABLED=true
PIE_WEB_CHAT_UID=1000
PIE_WEB_CHAT_GID=1000

# 아래 값은 예시를 복사하지 말고 충분히 긴 난수로 각각 새로 생성한다.
POSTGRES_PASSWORD=replace-with-random-hex
RELAY_JWT_SECRET=replace-with-random-hex
PIE_RELAY_ROUTING_SECRET=replace-with-a-different-random-hex
RELAY_POOL_ID=kroot-studio
RELAY_ALLOWED_APPLICATIONS=pie-control,kroot-studio
RELAY_REQUIRE_POOL_SCOPE=true
RELAY_ALLOW_DIRECT_TOKENS_WITHOUT_POOL_SCOPE=true
PIE_RELAY_DEFAULT_APPLICATION_ID=kroot-studio
PIE_RELAY_HEARTBEAT_TIMEOUT=90s
HOST_ENROLL_SECRET=replace-with-random-hex
PIE_RELAY_PRESENCE_TOKEN=replace-with-random-hex
PIE_RELAY_CONTROL_TOKEN=replace-with-random-hex
PIE_RELAY_INTERNAL_ALIAS=pie-sandbox-test-relay
PIE_MANAGER_INTERNAL_ALIAS=pie-sandbox-test-manager
PIE_RELAY_METRICS_TOKEN=replace-with-random-hex
PIE_MANAGER_ADMIN_TOKEN=replace-with-random-hex
PIE_DEVICE_AUTH_SECRET=replace-with-a-product-specific-device-jwt-secret-of-at-least-32-bytes
PIE_USER_WEBHOOK_SECRET=replace-with-random-hex
PIE_PREVIEW_GATEWAY_TOKEN=replace-with-a-different-random-hex
PIE_PREVIEW_ACCESS_SECRET=replace-with-another-random-hex
PIE_PREVIEW_DOMAIN=preview.kroot.io
PIE_PREVIEW_PUBLIC_SCHEME=https
PIE_PREVIEW_PUBLIC_PORT=0
PIE_PREVIEW_GATEWAY_CONTAINER=pie-sandbox-test-preview-gateway
PIE_PREVIEW_DEFAULT_TTL=4h
PIE_PREVIEW_MAX_TTL=24h
PIE_PREVIEW_SESSION_TTL=8h

# 공유 서버의 최초 검증값. 측정 없이 올리지 않는다.
PIE_EXECUTOR_CPUS=1
PIE_EXECUTOR_MEMORY=4g
PIE_EXECUTOR_PIDS_LIMIT=256
PIE_EXECUTOR_QUEUE_CAPACITY=16
PIE_EXECUTOR_WORKERS=2
PIE_EXECUTOR_PROVISION_CONCURRENCY=1
PIE_EXECUTOR_MAX_EXECUTORS=15
PIE_CHAT_IDLE_SCAN_INTERVAL=1m
PIE_CHAT_SESSION_IDLE_TIMEOUT=15m
PIE_EXECUTOR_IDLE_TIMEOUT=1h

# 외부 인증 introspection을 붙일 때에만 설정한다.
PIE_AUTH_INTROSPECTION_URL=
PIE_AUTH_CLIENT_ID=
PIE_AUTH_CLIENT_SECRET=
