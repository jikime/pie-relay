# deploy/.env.example을 복사해 만든 Kroot Studio 전용 비공개 환경 파일에
# 아래 값을 적용한다. Secret 값은 Vibe Canvas와 절대 공유하지 않는다.
# Kroot 사용자 인증은 일회용 코드가 아니라 사용자별 ~/.kroot/credential.json의
# PAT와 Kroot auth introspection을 사용한다. PAT를 이 공용 환경 파일에 넣지 않는다.
COMPOSE_PROJECT_NAME=pie-relay-kroot-studio
RELAY_NODE_ID=kroot-studio-relay-1
RELAY_POOL_ID=kroot-studio
RELAY_ALLOWED_APPLICATIONS=pie-control,kroot-studio
PIE_RELAY_DEFAULT_APPLICATION_ID=kroot-studio
PIE_EXECUTOR_MANAGER_ID=kroot-studio-manager-1
PIE_EXECUTOR_NETWORK=kroot-studio-executor
PIE_EXECUTOR_KROOT_AUTO_LINK=true
PIE_PREVIEW_GATEWAY_CONTAINER=kroot-studio-preview-gateway
PIE_PREVIEW_DOMAIN=preview.kroot.io
PIE_CLAUDE_AUTH_REQUIRED=true
# 현재 공유 서버의 Kroot Studio 검증 주소다. 운영 전용 도메인이 생기면 이 세 값만
# Kroot Studio 소유 도메인으로 바꾸고 Vibe Canvas 주소는 사용하지 않는다.
RELAY_PUBLIC_URL=https://relay-test.cookai.dev
PIE_EXECUTOR_RELAY_URL=wss://relay-test.cookai.dev/ws/agent
PIE_TRAEFIK_ROUTE_PREFIX=kroot-studio-test
PIE_TRAEFIK_ROUTE_PRIORITY=100
PIE_RELAY_HOST=relay-test.cookai.dev
PIE_MANAGER_API_HOST=api-relay-test.cookai.dev
PIE_MANAGER_ADMIN_HOST=admin-relay-test.cookai.dev
PIE_WEB_CHAT_MANAGER_URL=https://api-relay-test.cookai.dev
