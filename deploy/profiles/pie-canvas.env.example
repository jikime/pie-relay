# deploy/.env.example을 복사해 만든 Vibe Canvas 전용 비공개 환경 파일에
# 아래 값을 적용한다. Secret 값은 kroot-studio와 절대 공유하지 않는다.
# pie-canvas는 기존 장치 자격과의 호환을 위해 유지하는 내부 slug다.
COMPOSE_PROJECT_NAME=pie-relay-pie-canvas
RELAY_NODE_ID=pie-canvas-relay-1
RELAY_POOL_ID=pie-relay-default
RELAY_ALLOWED_APPLICATIONS=pie-control,pie-canvas
PIE_RELAY_DEFAULT_APPLICATION_ID=pie-canvas
PIE_EXECUTOR_MANAGER_ID=pie-canvas-manager-1
PIE_EXECUTOR_NETWORK=pie-canvas-executor
PIE_EXECUTOR_KROOT_AUTO_LINK=false
PIE_PREVIEW_GATEWAY_CONTAINER=pie-canvas-preview-gateway
# Vibe Canvas는 Kroot Studio의 *.preview.kroot.io를 소유하지 않는다. 전용 Preview
# 도메인과 인증서가 준비될 때까지 예약 TLD로 외부 route를 비활성화한다.
PIE_PREVIEW_DOMAIN=preview-vibe.invalid
PIE_CLAUDE_AUTH_REQUIRED=true
RELAY_PUBLIC_URL=https://relay.cookai.dev
PIE_EXECUTOR_RELAY_URL=wss://relay.cookai.dev/ws/agent
PIE_TRAEFIK_ROUTE_PREFIX=pie-canvas
PIE_TRAEFIK_ROUTE_PRIORITY=200
PIE_RELAY_HOST=relay.cookai.dev
PIE_MANAGER_API_HOST=api-relay.cookai.dev
PIE_MANAGER_ADMIN_HOST=admin-relay.cookai.dev
