# Optional. Unset means the default CookAI Relay.
# PIE_RELAY_URL=https://pie-relay-test.wonderfulplant-4d48fbdb.koreacentral.azurecontainerapps.io

# Local Relay example (use the host's LAN IP for a physical mobile device):
# PIE_RELAY_URL=http://127.0.0.1:13412

# Managed Control Plane session context. Keep all three unset for legacy mode.
VITE_PIE_RELAY_APPLICATION_ID=pie-relay-desktop
VITE_PIE_RELAY_POOL_ID=pie-relay-default
# Unset means the authenticated organization or user ID.
VITE_PIE_RELAY_TENANT_ID=
